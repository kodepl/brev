---
import site from "../site.config";
import { rubricSlug } from "../site.config";
const { title, description = site.tagline, image = site.heroImage } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>if(location.hostname.indexOf("www.")!==0){location.replace(location.href.replace("://","://www."));}</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {site.name}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={`${title} · ${site.name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content="pl_PL" />
    <meta name="robots" content="index,follow" />
    <link rel="icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&display=swap" rel="stylesheet" />
    <style is:global>
      body { font-family: "DM Sans", ui-sans-serif, system-ui; }
      h1, h2, h3, .font-serif { font-family: "Fraunces", Georgia, serif; }
    </style>
  </head>
  <body class="bg-stone-50 text-stone-800 antialiased">
    <header class="mx-auto max-w-3xl px-5 pb-6 pt-10">
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <a href="/" class="font-serif text-2xl font-semibold tracking-tight text-stone-900">{site.name}</a>
        <p class="max-w-xs text-right text-xs leading-snug text-stone-500">{site.tagline}</p>
      </div>
      <nav class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm font-medium text-stone-600">
        <a href="/" class="hover:text-teal-800">Start</a>
        <a href="/blog/" class="hover:text-teal-800">Blog</a>
        <a href="/dzialy/" class="hover:text-teal-800">Działy</a>
        <a href="/o-nas/" class="hover:text-teal-800">O nas</a>
        <a href="/kontakt/" class="hover:text-teal-800">Kontakt</a>
      </nav>
      <hr class="mt-6 border-stone-200" />
    </header>
    <slot />
    <footer class="mx-auto max-w-3xl border-t border-stone-200 px-5 py-10 text-center text-xs text-stone-500">
      <p class="text-sm text-stone-700">{site.address}</p>
      <p class="mt-2"><a href={`mailto:${site.email}`}>{site.email}</a></p>
      <p class="mt-3">
        {site.rubrics.map((r, i) => (
          <>
            {i > 0 && " · "}
            <a href={`/dzialy/${rubricSlug(r.name)}/`}>{r.name}</a>
          </>
        ))}
      </p>
      <p class="mt-3"><a href="/polityka-prywatnosci/">Prywatność</a> · <a href="/regulamin/">Regulamin</a></p>
      <p class="mt-2">© {new Date().getFullYear()} {site.name}, Łódź</p>
    </footer>
    <script type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token":"PLACEHOLDER_ANALYTICS"}'></script>
  </body>
</html>
