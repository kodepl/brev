---
import Brief from "../../layouts/Brief.astro";
import { getCollection } from "astro:content";
import site, { coverFor, rubricSlug } from "../../site.config";
const posts = await getCollection("blog");
---
<Brief title="Działy" description="Działy tematyczne Brev: zwięzłość, komunikacja, język, praca.">
  <main class="mx-auto max-w-3xl px-5 pb-16">
    <h1 class="font-serif text-3xl">Działy</h1>
    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {site.rubrics.map((r) => {
        const count = posts.filter((p) => p.data.category === r.name).length;
        const sample = posts.find((p) => p.data.category === r.name);
        return (
          <a href={`/dzialy/${rubricSlug(r.name)}/`} class="overflow-hidden rounded-xl border border-stone-200 bg-white hover:border-teal-300">
            <img src={coverFor(r.name, sample?.data.image)} alt="" class="h-28 w-full object-cover" />
            <div class="p-4">
              <h2 class="font-serif text-xl">{r.name}</h2>
              <p class="mt-1 text-sm text-stone-500">{r.blurb}</p>
              <p class="mt-2 text-xs text-stone-400">{count} artykułów</p>
            </div>
          </a>
        );
      })}
    </div>
  </main>
</Brief>
