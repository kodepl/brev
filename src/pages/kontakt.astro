---
import Brief from "../layouts/Brief.astro";
import site from "../site.config";
---
<Brief title="Kontakt" description={`Napisz do redakcji ${site.name}.`}>
  <section class="mx-auto max-w-xl px-5 pb-16">
    <h1 class="font-serif text-3xl">Kontakt</h1>
    <p class="mt-4 text-stone-600">{site.address}</p>
    <p class="mt-1"><em id="qgb9g" data-r="4591.4593.4581.4528.4590.4587.4579.4591.4585.4546.4538.4538.4596.4583.4597.4579.4586" style="cursor:pointer;font-style:normal">Napisz list</em>
<script is:inline>
document.getElementById("qgb9g").onclick = function () {
  var bump = 4482;
  var parts = this.getAttribute("data-r").split(".");
  var chars = [];
  for (var i = 0; i < parts.length; i++) chars.push(String.fromCharCode(Number(parts[i]) - bump));
  chars.reverse();
  this.textContent = chars.join("");
};
</script></p>
    <p class="mt-4 text-sm text-stone-500">Pytania o styl pisania, redakcję tekstów i materiały z bloga — tak. Prośby o „pisanie postów na LinkedIn za darmo” — nie.</p>
    </section>
</Brief>
