---
import Brief from "../layouts/Brief.astro";
import { getCollection } from "astro:content";
import site, { coverFor, rubricSlug } from "../site.config";
const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const lead = posts[0];
const rest = posts.slice(1, 7);
---
<Brief title={site.name} description={site.tagline} image={site.heroImage}>
  <main class="mx-auto max-w-3xl px-5 pb-16">
    <img src={site.heroImage} alt="Biurko z notatkami" class="h-52 w-full rounded-xl object-cover ring-1 ring-stone-200" />
    <p class="mt-8 text-sm leading-relaxed text-stone-600">
      Redakcja z Łodzi o tym, jak pisać krócej i mówić jaśniej. Maile, pitch, notatki ze spotkań — bez korporacyjnego bełkotu.
    </p>
    <nav class="my-8 flex flex-wrap gap-2">
      {site.rubrics.map((r) => (
        <a href={`/dzialy/${rubricSlug(r.name)}/`} class="rounded-full border border-stone-300 bg-white px-3 py-1 text-xs font-medium text-teal-900 hover:border-teal-400">{r.name}</a>
      ))}
    </nav>
    {lead && (
      <article class="border-b border-stone-200 pb-10">
        <img src={coverFor(lead.data.category, lead.data.image)} alt="" class="h-48 w-full rounded-xl object-cover" />
        <p class="mt-5 text-xs font-semibold uppercase tracking-widest text-teal-700">{lead.data.category}</p>
        <h2 class="mt-2 font-serif text-3xl leading-snug"><a href={`/blog/${lead.slug}/`}>{lead.data.title}</a></h2>
        <p class="mt-3 text-stone-600">{lead.data.description}</p>
      </article>
    )}
    <div class="mt-8 space-y-8">
      {rest.map((post) => (
        <article class="border-b border-stone-100 pb-6">
          <p class="text-xs font-semibold uppercase tracking-wide text-teal-700">{post.data.category}</p>
          <h2 class="mt-1 font-serif text-xl leading-snug"><a href={`/blog/${post.slug}/`}>{post.data.title}</a></h2>
          <p class="mt-2 text-sm text-stone-500">{post.data.description}</p>
        </article>
      ))}
    </div>
  </main>
</Brief>
