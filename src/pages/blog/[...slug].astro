---
import Brief from "../../layouts/Brief.astro";
import site, { coverFor } from "../../site.config";
import { getCollection } from "astro:content";
import GithubSlugger from "github-slugger";
export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await post.render();
const slugger = new GithubSlugger();
const headings = (post.body.match(/^##\s+(.+)$/gm) || []).map((line) => {
  const text = line.replace(/^##\s+/, "");
  return { text, id: slugger.slug(text) };
});
const minutes = Math.max(1, Math.round(post.body.split(/\s+/).filter(Boolean).length / 200));
const author = post.data.author ?? site.author;
const bio = post.data.authorBio ?? site.authorBio;
const cover = coverFor(post.data.category, post.data.image);
const related = (await getCollection("blog")).filter((p) => p.slug !== post.slug && p.data.category === post.data.category).slice(0, 3);
---
<Brief title={post.data.title} description={post.data.description} image={cover}>
  <div class="mx-auto max-w-3xl px-5 pb-16">
    <p class="text-xs font-semibold uppercase tracking-wide text-teal-700">{post.data.category}</p>
    <h1 class="mt-2 font-serif text-3xl font-semibold leading-snug">{post.data.title}</h1>
    <p class="mt-2 text-sm text-stone-500">Czas czytania: {minutes} min · {author}</p>
    <img src={cover} alt="" class="mt-6 h-52 w-full rounded-xl object-cover ring-1 ring-stone-200" />
    {headings.length > 0 && (
      <nav class="mt-6 rounded-xl border border-stone-200 bg-white p-4 text-sm">
        <p class="font-semibold">Spis treści</p>
        <ol class="mt-2 space-y-1">
          {headings.map((h) => <li><a href={`#${h.id}`} class="text-teal-800 hover:underline">{h.text}</a></li>)}
        </ol>
      </nav>
    )}
    <div class="prose prose-stone prose-lg mt-8 max-w-none">
      <Content />
    </div>
    <section class="mt-12 flex gap-4 border-t border-stone-200 pt-6">
      <img src={site.authorAvatar} alt={author} class="h-14 w-14 rounded-full object-cover" />
      <div>
        <p class="font-semibold">{author}</p>
        <p class="text-sm text-stone-600">{bio}</p>
      </div>
    </section>
    {related.length > 0 && (
      <div class="mt-8">
        <h3 class="font-serif font-semibold text-stone-800">Powiązane</h3>
        <ul class="mt-3 space-y-2 text-sm">
          {related.map((item) => (
            <li><a href={`/blog/${item.slug}/`} class="text-teal-800 hover:underline">{item.data.title}</a></li>
          ))}
        </ul>
      </div>
    )}
  </div>
</Brief>
